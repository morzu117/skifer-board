{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skifer-board.dev/schema/dashboard.v1.json",
  "title": "Dashboard as YAML v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "skifer-board/v1" },
    "kind": { "const": "Dashboard" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "modelKey": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "binding": {
      "type": "string",
      "pattern": "^\\$filters\\.[a-z][a-z0-9_]*$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 1024 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "nameArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/name" },
      "maxItems": 50
    },
    "metadata": {
      "type": "object",
      "required": ["slug", "title"],
      "additionalProperties": false,
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["tiles"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/globalFilter" }
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tile" }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "default": 12
        }
      }
    },
    "globalFilter": {
      "oneOf": [
        { "$ref": "#/$defs/dimensionFilter" },
        { "$ref": "#/$defs/periodFilter" }
      ]
    },
    "dimensionFilter": {
      "type": "object",
      "required": ["name", "dimension"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "dimension" },
        "name": { "$ref": "#/$defs/identifier" },
        "dimension": { "$ref": "#/$defs/name" },
        "default": {
          "oneOf": [
            { "$ref": "#/$defs/scalar" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/scalar" },
              "maxItems": 50
            },
            { "type": "null" }
          ]
        }
      }
    },
    "periodFilter": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "period" },
        "name": { "$ref": "#/$defs/identifier" },
        "default": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "position": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show": { "type": "boolean", "default": true }
      }
    },
    "tile": {
      "type": "object",
      "required": ["id", "position", "query", "viz"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "position": { "$ref": "#/$defs/position" },
        "query": { "$ref": "#/$defs/query" },
        "viz": { "$ref": "#/$defs/viz" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "ignore_filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "queryFilter": {
      "type": "object",
      "required": ["column", "operator"],
      "additionalProperties": false,
      "properties": {
        "column": { "$ref": "#/$defs/name" },
        "operator": {
          "enum": ["eq", "neq", "gt", "lt", "gte", "lte", "in", "like", "is_null", "is_not_null"]
        },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/scalar" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/scalar" },
              "maxItems": 50
            }
          ]
        }
      }
    },
    "query": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/modelKey" },
        "metrics": { "$ref": "#/$defs/nameArray" },
        "group_by": { "$ref": "#/$defs/nameArray" },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/queryFilter" },
          "maxItems": 50
        },
        "date_from": { "$ref": "#/$defs/isoDate" },
        "date_to": { "$ref": "#/$defs/isoDate" },
        "period": { "type": "string", "minLength": 1 }
      }
    },
    "format": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "enum": ["number", "integer", "percent", "currency_eur", "currency_usd"]
      }
    },
    "kpiViz": {
      "type": "object",
      "required": ["kind", "metric"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "kpi" },
        "metric": { "$ref": "#/$defs/name" },
        "format": { "$ref": "#/$defs/format" }
      }
    },
    "tableViz": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "table" },
        "columns": { "$ref": "#/$defs/nameArray" },
        "format": { "$ref": "#/$defs/format" }
      }
    },
    "barViz": {
      "type": "object",
      "required": ["kind", "x", "series"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "bar" },
        "x": { "$ref": "#/$defs/name" },
        "series": {
          "type": "array",
          "items": { "$ref": "#/$defs/name" },
          "minItems": 1
        },
        "format": { "$ref": "#/$defs/format" }
      }
    },
    "lineViz": {
      "type": "object",
      "required": ["kind", "x", "series"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "line" },
        "x": { "$ref": "#/$defs/name" },
        "series": {
          "type": "array",
          "items": { "$ref": "#/$defs/name" },
          "minItems": 1
        },
        "format": { "$ref": "#/$defs/format" }
      }
    },
    "viz": {
      "oneOf": [
        { "$ref": "#/$defs/kpiViz" },
        { "$ref": "#/$defs/tableViz" },
        { "$ref": "#/$defs/barViz" },
        { "$ref": "#/$defs/lineViz" }
      ]
    }
  }
}
