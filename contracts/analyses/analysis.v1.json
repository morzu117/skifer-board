{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skifer-board.dev/schema/analysis.v1.json",
  "title": "board.analysis/v1",
  "description": "Analyse versionnée de Board : une requête déclarative, des calculs contextuels ordonnés et une présentation par défaut. Ni SQL, ni donnée, ni sélection temporaire, ni secret. Les règles que JSON Schema n'exprime pas (références entre champs, valeurs de filtres) sont vérifiées par le serveur et listées dans la section Réalisation 18.1 de docs/roadmap/18_analyses_versionnees_plan.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "name",
    "description",
    "visibility",
    "owner",
    "query",
    "contextual",
    "presentation"
  ],
  "properties": {
    "api_version": { "const": "board.analysis/v1" },
    "id": { "$ref": "#/$defs/uuid" },
    "name": { "$ref": "#/$defs/name" },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]*$(?!\\n)"
    },
    "visibility": { "enum": ["personal", "shared"] },
    "owner": { "$ref": "#/$defs/person" },
    "query": { "$ref": "#/$defs/query" },
    "contextual": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/contextual_operation" }
    },
    "presentation": { "$ref": "#/$defs/presentation" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?!\\n)"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$(?!\\n)"
    },
    "connection_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$(?!\\n)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]+$(?!\\n)"
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject"],
      "properties": {
        "issuer": { "$ref": "#/$defs/person_part" },
        "subject": { "$ref": "#/$defs/person_part" }
      }
    },
    "person_part": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]+$(?!\\n)"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection", "model", "metrics", "dimensions", "filters"],
      "properties": {
        "connection": { "$ref": "#/$defs/connection_name" },
        "model": { "$ref": "#/$defs/identifier" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "dimensions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "filters": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/filter" }
        }
      }
    },
    "scalar": {
      "type": ["string", "number", "boolean"],
      "maxLength": 1024
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "operator", "value"],
      "properties": {
        "column": { "$ref": "#/$defs/identifier" },
        "operator": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "between"] },
        "value": true
      },
      "if": {
        "properties": { "operator": { "enum": ["in", "between"] } },
        "required": ["operator"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/$defs/scalar" }
          }
        }
      },
      "else": {
        "properties": { "value": { "$ref": "#/$defs/scalar" } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "const": "between" } },
            "required": ["operator"]
          },
          "then": {
            "properties": { "value": { "minItems": 2, "maxItems": 2 } }
          }
        }
      ]
    },
    "contextual_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "metric", "group_by"],
      "properties": {
        "operation": { "enum": ["aggregate", "share"] },
        "metric": { "$ref": "#/$defs/identifier" },
        "group_by": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "scope": { "enum": [null, "filtered_perimeter"] },
        "denominator": { "enum": ["loaded_result", "filtered_perimeter"] }
      },
      "if": {
        "properties": { "operation": { "const": "share" } },
        "required": ["operation"]
      },
      "then": {
        "required": ["denominator"],
        "properties": { "scope": { "not": {} } }
      },
      "else": {
        "required": ["scope"],
        "properties": { "denominator": { "not": {} } }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart"],
      "properties": {
        "chart": { "enum": ["value", "bars", "line", "grouped_bars"] }
      }
    }
  }
}
