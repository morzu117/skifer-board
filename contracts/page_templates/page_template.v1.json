{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skifer-board.dev/schema/page_template.v1.json",
  "title": "board.page_template/v1",
  "description": "Squelette sans analyse ni cible. Les bornes globales, identifiants, largeurs, profondeur et valeurs de filtre sont vérifiés par le serveur.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "name",
    "description",
    "owner",
    "defaults",
    "filters",
    "layout"
  ],
  "properties": {
    "api_version": {
      "const": "board.page_template/v1"
    },
    "id": {
      "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/uuid"
    },
    "name": {
      "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/name"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]*$(?!\\n)"
    },
    "owner": {
      "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/person"
    },
    "defaults": {
      "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/defaults"
    },
    "filters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "layout": {
      "$ref": "#/$defs/layout"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "container",
            "slot",
            "text",
            "separator"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "container"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/container"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slot"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/slot"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/text_component"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "separator"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/separator_component"
          }
        }
      ]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "expected",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/uuid"
        },
        "type": {
          "const": "slot"
        },
        "expected": {
          "enum": [
            "visual",
            "kpi"
          ]
        },
        "label": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/short_label"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "rows"
      ],
      "properties": {
        "id": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/uuid"
        },
        "type": {
          "const": "container"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "columns"
      ],
      "properties": {
        "id": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/uuid"
        },
        "columns": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "span",
        "children"
      ],
      "properties": {
        "id": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/uuid"
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "children": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rows"
      ],
      "properties": {
        "id": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/uuid"
        },
        "title": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/name"
        },
        "rows": {
          "$ref": "#/$defs/rows"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "dimension",
        "operator"
      ],
      "properties": {
        "id": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/uuid"
        },
        "label": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/short_label"
        },
        "dimension": {
          "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/identifier"
        },
        "operator": {
          "enum": [
            "eq",
            "in",
            "between"
          ]
        },
        "default": true,
        "allowed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/scalar"
          }
        }
      },
      "if": {
        "properties": {
          "operator": {
            "enum": [
              "in",
              "between"
            ]
          }
        },
        "required": [
          "operator"
        ]
      },
      "then": {
        "properties": {
          "default": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/scalar"
            }
          }
        }
      },
      "else": {
        "properties": {
          "default": {
            "$ref": "https://skifer-board.dev/schema/dashboard.v1.json#/$defs/scalar"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "between"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
